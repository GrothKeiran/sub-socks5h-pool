# 只在本地填写，不要提交到 Git 或发给在线订阅转换服务。
SUBSCRIPTION_URL=https://your-subscription.example/sub?token=replace-me

SOCKS_HOST=127.0.0.1
SOCKS_PORT=1080
# 本地可留空；Docker 或非回环监听必须同时设置这两个值。
SOCKS_USERNAME=
SOCKS_PASSWORD=

ADMIN_HOST=127.0.0.1
ADMIN_PORT=8090
# 本地留空时自动生成 data/admin.token；Docker 必须显式配置。
ADMIN_TOKEN=

# 两小时更新一次，五分钟重新探测一次全部候选节点。
REFRESH_SECONDS=7200
HEALTH_SECONDS=300
# 订阅连续更新失败，距上次成功更新超过三小时后拒绝新连接。
MAX_STALE_SECONDS=10800
MAX_NODES=256
PROBE_CONCURRENCY=8
PROBE_TIMEOUT=12
# 纯文本公网 IP 或 {"ip":"公网IP"}；用 IPv4 回显减少双栈误判。
PROBE_URL=https://api4.ipify.org
# 默认允许单 IP 继续服务；设为 2 可恢复严格的双出口门槛。
MIN_DISTINCT_IPS=1
# 默认接受探测期间会动态换 IP 的节点；true 表示只接纳双次回显一致的节点。
REQUIRE_STABLE_EXIT=false
FAILURE_THRESHOLD=2
CONNECT_TIMEOUT=20
# 单方向超过此时间无数据则结束连接；超长推理可调大。
RELAY_IDLE_TIMEOUT=300
